<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <BuildTarget>Client</BuildTarget>
    <Company>QK</Company>
    <PlatformName Condition="'$(PlatformName)' == ''">Windows</PlatformName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameReferenceVersion Condition="'$(GameReferenceVersion)' == ''">1.15.33.2</GameReferenceVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/**/*.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameVersion</_Parameter1>
      <_Parameter2>$(GameReferenceVersion)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="Barotrauma.ReferenceAssemblies.Vanilla" Version="[$(GameReferenceVersion)]" GeneratePathProperty="true" />
    <PackageReference Include="Barotrauma.ReferenceAssemblies.Libraries" Version="[$(GameReferenceVersion)]" />
    <PackageReference Include="HarmonyX" Version="[2.16.0]" />
    <PackageReference Include="System.Collections.Immutable" Version="[9.0.0]" />
  </ItemGroup>
  <Target Name="CheckGameReferenceVersion" AfterTargets="ResolveReferences">
    <GetAssemblyIdentity AssemblyFiles="$(PkgBarotrauma_ReferenceAssemblies_Vanilla)/assemblies/$(PlatformName)/Barotrauma.dll">
      <Output TaskParameter="Assemblies" ItemName="GameReferenceIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'@(GameReferenceIdentity->'%(Version)')' != '$(GameReferenceVersion)'" Text="Game reference assembly version does not match the requested version." />
  </Target>
</Project>
